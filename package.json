{
  "name": "droidbridge",
  "displayName": "DroidBridge",
  "description": "Live, touchable Android phone and tablet mirror inside VS Code, plus an MCP server that lets AI agents see and control your device.",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other",
    "Debuggers",
    "Testing",
    "AI"
  ],
  "keywords": [
    "adb",
    "agent",
    "ai",
    "android",
    "automation",
    "copilot",
    "debugging",
    "device",
    "mcp",
    "mobile",
    "scrcpy",
    "screen-mirror",
    "tablet",
    "wireless"
  ],
  "author": {
    "name": "Lusan Sapkota"
  },
  "license": "MIT",
  "icon": "media/icons/droidbridge-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lusan-sapkota/DroidBridge"
  },
  "bugs": {
    "url": "https://github.com/Lusan-sapkota/DroidBridge/issues"
  },
  "homepage": "https://github.com/Lusan-sapkota/DroidBridge#readme",
  "publisher": "lusansapkota",
  "galleryBanner": {
    "color": "#073042",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "droidbridge.connectDevice",
        "title": "Connect to Device",
        "category": "DroidBridge"
      },
      {
        "command": "droidbridge.disconnectDevice",
        "title": "Disconnect Device",
        "category": "DroidBridge"
      },
      {
        "command": "droidbridge.launchScrcpy",
        "title": "Launch Scrcpy",
        "category": "DroidBridge"
      },
      {
        "command": "droidbridge.launchScrcpyScreenOff",
        "title": "Launch Scrcpy Screen Off",
        "category": "DroidBridge"
      },
      {
        "command": "droidbridge.stopScrcpy",
        "title": "Stop Scrcpy",
        "category": "DroidBridge"
      },
      {
        "command": "droidbridge.showLogs",
        "title": "Show Logs",
        "category": "DroidBridge"
      },
      {
        "command": "droidbridge.checkBinaries",
        "title": "Check Binary Status",
        "category": "DroidBridge"
      },
      {
        "command": "droidbridge.downloadBinaries",
        "title": "Download Missing Binaries",
        "category": "DroidBridge"
      },
      {
        "command": "droidbridge.refreshBinaries",
        "title": "Refresh Binary Detection",
        "category": "DroidBridge"
      },
      {
        "command": "droidbridge.pairDevice",
        "title": "Pair Device (Manual)",
        "category": "DroidBridge"
      },
      {
        "command": "droidbridge.startMirror",
        "title": "Start Screen Mirror",
        "category": "DroidBridge",
        "icon": "$(play)"
      },
      {
        "command": "droidbridge.stopMirror",
        "title": "Stop Screen Mirror",
        "category": "DroidBridge",
        "icon": "$(debug-stop)"
      },
      {
        "command": "droidbridge.openMirrorInEditor",
        "title": "Open Screen Mirror in Editor Tab",
        "category": "DroidBridge",
        "icon": "$(link-external)"
      },
      {
        "command": "droidbridge.openMirrorNative",
        "title": "Open Screen Mirror in Native Window",
        "category": "DroidBridge",
        "icon": "$(window)"
      },
      {
        "command": "droidbridge.setupMcp",
        "title": "Set Up AI Agent Access (MCP)",
        "category": "DroidBridge",
        "icon": "$(sparkle)"
      }
    ],
    "views": {
      "droidbridge": [
        {
          "type": "webview",
          "id": "droidbridge-sidebar",
          "name": "Device Manager",
          "when": "true",
          "icon": "media/icons/activity-bar.svg"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "droidbridge",
          "title": "DroidBridge",
          "icon": "media/icons/activity-bar.svg"
        }
      ]
    },
    "configuration": {
      "title": "DroidBridge",
      "properties": {
        "droidbridge.adbPath": {
          "type": "string",
          "default": "",
          "description": "Custom path to the ADB binary. Leave empty to detect it automatically."
        },
        "droidbridge.scrcpyPath": {
          "type": "string",
          "default": "",
          "description": "Custom path to the scrcpy binary (used by the native window). Leave empty to detect it automatically."
        },
        "droidbridge.defaultIp": {
          "type": "string",
          "default": "192.168.1.100",
          "description": "Default IP address for ADB connection."
        },
        "droidbridge.defaultPort": {
          "type": "string",
          "default": "5555",
          "description": "Default port for ADB connection."
        },
        "droidbridge.scrcpy.maxSize": {
          "type": "number",
          "default": 1024,
          "minimum": 0,
          "description": "Maximum mirror resolution (longest side, in pixels). The window keeps the device aspect ratio, so phones and tablets both fit. Use 0 for native resolution."
        },
        "droidbridge.scrcpy.bitrate": {
          "type": "string",
          "default": "8M",
          "description": "Video bitrate passed to scrcpy (for example 4M or 16M). Raise it for high resolution tablets."
        },
        "droidbridge.scrcpy.alwaysOnTop": {
          "type": "boolean",
          "default": true,
          "description": "Keep the mirror window above other windows."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "droidbridge.startMirror",
          "when": "view == droidbridge-sidebar && !droidbridge.mirrorRunning",
          "group": "navigation@1"
        },
        {
          "command": "droidbridge.stopMirror",
          "when": "view == droidbridge-sidebar && droidbridge.mirrorRunning",
          "group": "navigation@1"
        },
        {
          "command": "droidbridge.openMirrorInEditor",
          "when": "view == droidbridge-sidebar",
          "group": "navigation@2"
        },
        {
          "command": "droidbridge.setupMcp",
          "when": "view == droidbridge-sidebar",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "droidbridge.stopMirror",
          "when": "droidbridge.mirrorRunning"
        }
      ]
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "droidbridge",
        "label": "DroidBridge Android"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vscode-test",
    "test:unit": "npm run compile-tests && vscode-test --run --grep \"Unit Tests\"",
    "test:integration": "npm run compile-tests && vscode-test --run --grep \"Integration Tests\"",
    "test:e2e": "npm run compile-tests && vscode-test --run --grep \"End-to-End\"",
    "test:coverage": "npm run compile-tests && c8 vscode-test --run",
    "test:watch": "npm run compile-tests && vscode-test --run --watch",
    "clean": "rimraf dist out *.vsix",
    "package:vsix": "npm run package && vsce package",
    "publish": "npm run package && vsce publish",
    "publish:pre": "npm run package && vsce publish --pre-release",
    "publish:interactive": "node scripts/publish.js",
    "validate": "node scripts/validate.js"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/sinon": "^17.0.4",
    "@types/vscode": "^1.104.0",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.2.1",
    "c8": "^10.1.2",
    "esbuild": "^0.25.9",
    "eslint": "^9.34.0",
    "glob": "^11.0.0",
    "mocha": "^10.8.2",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.0.1",
    "sinon": "^21.0.0",
    "typescript": "^5.9.2"
  }
}
